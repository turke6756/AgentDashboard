node_modules/
dist/
dist-dev/
logs/
*.db
.env
process.exit()
*.log
*.vsix
vscode-extension/out/
release/
# Any packaging output dir, not just `release/`. A stale copy named
# `release.stale-<date>-backup/` once sat outside this rule and put 1.3 GiB of
# Electron payload into checkpoint scope, silently pushing the workspace over
# MAX_CHECKPOINT_BYTES so no turn was ever checkpointed. Zero tracked paths
# start with `release`, so this pattern cannot shadow repo content.
release*/
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Private documentation — internal design/bug notes live under docs/internal/
# (ignored); docs/ root is public (curated launch docs). Anchored so it only
# ignores the internal subtree, never the public docs.
/docs/internal/

# Raw pressure-test dumps — kept locally, not shipped to the public repo.
experiments/

# Local-only working plans (repo-root dir only — anchored so it does NOT also
# ignore source under src/main/plans/, which is real committable code).
/plans/

# Automated backup files
*.bak.*

# Per-workspace runtime state (not part of repo template).
# `.lares/` is the live state-dir name; the `.dashboard/` twins stay because a
# not-yet-migrated (or rename-blocked) clone still carries the legacy dir.
.lares/.scaffold-versions.json
.lares/workers/
.lares/scripts/
.lares/pending-status.jsonl
# usage/ — local telemetry sinks (e.g. WP-P0PRE demand-probe.jsonl); never committed.
.lares/usage/
.lares/*/.claude/.sysprompt-*.txt
.lares/*/.claude/scheduled_tasks.lock
.lares/main-crash.log
# Per-agent sandbox homes may contain live provider credentials. The path is
# derived from the state-dir root and agent id; it is runtime state, never source.
/.lares/agent-homes/
# The root legacy dir is retired except for the research-store compatibility tier
# (its last tracked scaffold files were git rm'd 2026-08-04 — git checkouts
# were resurrecting the folder after the .lares rename).
/.dashboard/*
!/.dashboard/research/
!/.dashboard/library/
!/.dashboard/plans/
.dashboard/.scaffold-versions.json
.dashboard/workers/
.dashboard/scripts/
.dashboard/pending-status.jsonl
# usage/ — local telemetry sinks (e.g. WP-P0PRE demand-probe.jsonl); never committed.
.dashboard/usage/
.dashboard/*/.claude/.sysprompt-*.txt
.dashboard/*/.claude/scheduled_tasks.lock
.dashboard/main-crash.log
/.dashboard/agent-homes/

# Internal agent state that must not ship in the public scaffold (anchored/specific)
/.lares/*/memory/
/.lares/cdp-trace.*.jsonl
/.lares/staging/
/.lares/*/staging/
/.dashboard/*/memory/
/.dashboard/cdp-trace.*.jsonl
/.dashboard/staging/
/.dashboard/*/staging/
# Frozen analytics exports — machine-local, timestamped, pruned by the exporter.
# Contains workspace-scoped analytics; never committable.
/.lares/analytics/
/.lares/*/plan-surface-eval-handoff.md
/.lares/*/.claude/settings.local.json
/.dashboard/analytics/
/.dashboard/*/plan-surface-eval-handoff.md
/.dashboard/*/.claude/settings.local.json

# Plan manifests and every other durable plan-folder artifact are versioned.
# Ignore only the lock and write-temp siblings created by the manifest CAS path.
/.lares/plans/*/plan.json.lock*
/.lares/plans/*/plan.json.wtmp-*
/.dashboard/plans/*/plan.json.lock*
/.dashboard/plans/*/plan.json.wtmp-*

# >>> agentdashboard-research-store >>>
# Library inbox/ holds raw, untrusted, web-derived artifacts and
# must never be committed; cleared/ (reviewed) stays trackable. (Case A — no
# blanket /.lares/* ignore is in effect, so a single inbox/ rule suffices.
# Legacy `.dashboard` twin kept for unmigrated clones.)
/.lares/library/inbox/
/.dashboard/library/inbox/
/.lares/library/sources/
/.dashboard/library/sources/
/.lares/library/derived/
/.dashboard/library/derived/
/.lares/library/library.db*
/.dashboard/library/library.db*
# <<< agentdashboard-research-store <<<

# MCP config — generated per app launch, embeds a live API bearer token.
# It's a build artifact (the app rewrites it on every supervisor launch), so it
# must never be committed. The app regenerates it locally on each machine.
.mcp.json
**/.mcp.json

# Machine-local launchers — these hardcode an absolute developer path, so they
# are useless to anyone else cloning the repo. Keep your own copy locally.
/AgentDashboard.bat

# Agent work-package scratch trees (compiled test outputs etc.). Thousands of
# un-ignored files here put the dirty-inventory scan into multi-GB territory and
# OOM'd the main process twice (2026-08-08/09) — see
# .lares/proposals/2026-08-10-oom-incident-root-cause-and-hardening.md
# (prop_1d831b09). Zero tracked paths start
# with `.wp`, so this cannot shadow repo content. Agents: prefer scratch dirs
# OUTSIDE the repo entirely.
/.wp*

# Local scratch — throwaway files from spikes and manual pokes.
/hello.py
/proposed
/spike-hello-world.md

# Machine-local runtime descriptor (absolute paths) — generated at launch
/.lares/installation.json
/.dashboard/installation.json

# Bundled MinGit staging (WP-G0.5) — the fetched/verified Git-for-Windows payload
# is downloaded by scripts/fetch-mingit.mjs in release CI and packaged via
# build.extraResources; it is NEVER checked into git. git-runtime's dev fallback
# resolves the bundled git.exe out of this same path.
/third_party/git-for-windows/.staging/

# Lares-created scan exhaust (suggested to workspaces; accepted here).
/reachability-mutations/
/.lares/reachability-mutations/
/.dashboard/reachability-mutations/
/.lares/library/scratch/
/.dashboard/library/scratch/
/.lares/scratch/
/.dashboard/scratch/
/.lares/supervisor/scratch/
/.dashboard/supervisor/scratch/
/.lares/workers/*/scratch/
/.dashboard/workers/*/scratch/
/.lares/archive/
/.dashboard/archive/
/.lares/tmp/
/.dashboard/tmp/
/.lares/tmp-*
/.dashboard/tmp-*
/.lares/*.log
/.dashboard/*.log

# >>> workshop-vs-app boundary (2026-09-08) >>>
# The app's live workspace state and the developer's planning scratchpad are NOT
# product source. Product persona/skill/scaffold defaults live in src/shared/constants.ts
# and are written into .lares/ on launch. Nothing under these paths ships or gates.
/.lares/
/.lares-runtime/
/.dashboard/
/plans/
/research/
/reachability-mutations/
/probe-artifacts/
# <<< workshop-vs-app boundary <<<
